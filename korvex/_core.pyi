from collections.abc import Mapping, Sequence
from uuid import UUID

Param = str | int | UUID
"""A captured value: `int` for `{id:int}`, `UUID` for `{id:uuid}`, else `str`."""

class MethodNotAllowed(Exception):
    """The path exists, but not for this method (HTTP 405)."""

    allowed: list[str]
    """The methods registered for this path."""

class Router:
    def __init__(self) -> None: ...
    def route(
        self, path: str, handler: str, *, method: str = "GET", middleware: Sequence[str] | None = None
    ) -> None: ...
    def match(self, path: str, method: str = "GET") -> tuple[str, Mapping[str, Param], tuple[str, ...]] | None: ...
    def remove(self, path: str, method: str = "GET") -> bool: ...
    def routes(self) -> list[tuple[str, str, str, tuple[str, ...]]]: ...

# The built-in server (Linux and macOS only): used by App.run().

class Responder:
    def respond(self, status: int, headers: list[tuple[bytes, bytes]], body: bytes) -> None: ...
    def start_stream(self, status: int, headers: list[tuple[bytes, bytes]]) -> None: ...
    def send_chunk(self, chunk: bytes) -> bool: ...
    def end_stream(self) -> None: ...

class Server:
    def __init__(
        self,
        fd: int,
        unix: bool,
        max_body: int,
        timeout: float,
        body_limits: list[tuple[str, str, int]],
        trusted: list[str],
    ) -> None: ...
    def fileno(self) -> int: ...
    def take(
        self,
    ) -> list[tuple[str, str, bytes, list[tuple[bytes, bytes]], bytes, tuple[str, int] | None, str, Responder]]: ...
    def stop(self, grace: float) -> None: ...
    def finished(self) -> bool: ...
    def close(self) -> None: ...
