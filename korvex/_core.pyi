from collections.abc import Mapping, Sequence
from uuid import UUID

Param = str | int | UUID
"""A captured value: `int` for `{id:int}`, `UUID` for `{id:uuid}`, else `str`."""

class MethodNotAllowed(Exception):
    """The path exists, but not for this method (HTTP 405)."""

    allowed: list[str]
    """The methods registered for this path."""

class Router:
    def __init__(self) -> None: ...
    def route(
        self, path: str, handler: str, *, method: str = "GET", middleware: Sequence[str] | None = None
    ) -> None: ...
    def match(self, path: str, method: str = "GET") -> tuple[str, Mapping[str, Param], tuple[str, ...]] | None: ...
    def remove(self, path: str, method: str = "GET") -> bool: ...
    def routes(self) -> list[tuple[str, str, str, tuple[str, ...]]]: ...
    def constraint(self, name: str, pattern: str) -> None: ...
    def constraints(self) -> list[tuple[str, str]]: ...

# The built-in server (Linux and macOS only): used by App.run().

class Responder:
    id: int
    def respond(self, status: int, headers: list[tuple[bytes, bytes]], body: bytes) -> None: ...
    def start_stream(self, status: int, headers: list[tuple[bytes, bytes]]) -> None: ...
    def send_chunk(self, chunk: bytes) -> int: ...
    """0: the client is gone; 1: sent; 2: sent, wait for ("writable", id) before more."""
    def end_stream(self) -> None: ...
    def abort_stream(self) -> None: ...

class WsConnection:
    id: int
    def accept(self, subprotocol: str | None = None, headers: list[tuple[bytes, bytes]] = ...) -> None: ...
    def send_text(self, text: str) -> int: ...
    """Like Responder.send_chunk()."""
    def send_bytes(self, data: bytes) -> int: ...
    def close(self, code: int, reason: str) -> None: ...
    def finish(self) -> None: ...

class Server:
    def __init__(
        self,
        fd: int,
        unix: bool,
        max_body: int,
        timeout: float,
        body_limits: list[tuple[str, str, int]],
        trusted: list[str],
        ws_ping_interval: float,
        forwarded_host: bool,
        constraints: list[tuple[str, str]],
        max_connections: int,
    ) -> None: ...
    def fileno(self) -> int: ...
    def take(self) -> list[tuple]: ...
    """Events, each a tuple starting with "http", "ws", "ws_message", "ws_closed" or "writable"."""
    def stop(self, grace: float) -> None: ...
    def finished(self) -> bool: ...
    def close(self) -> None: ...

def escape_html(text: str) -> str: ...
